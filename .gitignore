
# === ENVIRONMENT VARIABLES ===
# Mengabaikan file rahasia seperti API Keys dan kredensial database
.env
.env.local
.env.*.local
*.env
# Kecualikan file contoh agar orang lain tahu variabel apa yang dibutuhkan
!.env.example

# === GO (GOLANG) ===
# Binaries and build objects
bin/
obj/
# Executable files
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binary, gopls, and other tools
*.test
__debug_bin
# Vendor directory (opsional, jika tidak ingin mengunggah dependensi)
# vendor/

# === FLUTTER & DART ===
# Folders generated by Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Android-specific
android/**/generated/
android/key.properties
android/local.properties

# iOS-specific
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework

# macOS-specific
macos/Flutter/GeneratedPluginRegistrant.swift

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
